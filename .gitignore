mt_tracking_repro_transfer/models/**/*.pt
mt_tracking_repro_transfer/models/**/*.pth
mt_tracking_repro_transfer/models/**/*.ckpt
mt_tracking_repro_transfer/archive/**/*.npz
mt_tracking_repro_transfer/archive/**/*.pt
mt_tracking_repro_transfer/archive/**/*.pth

# Generated plots and transient run logs
mt_tracking_repro_transfer/outputs/**/*.png
mt_tracking_repro_transfer/outputs/**/*.pdf
